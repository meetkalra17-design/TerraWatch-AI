# Frontend configuration. Copy to .env.local locally and never commit the copy.
VITE_BACKEND_URL=http://localhost:8001
VITE_FIRESTORE_ENABLED=false
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
VITE_SATELLITE_TILES_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_STREET_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
